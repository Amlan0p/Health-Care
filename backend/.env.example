# Copy to .env for local development. NEVER commit .env. Placeholders only below.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#   Local:  postgresql://USER:PASSWORD@localhost:5432/healthcare
#   Render: copy the "Internal Database URL" from your Render Postgres instance.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthcare

# Secret used to sign login tokens. REQUIRED in production, at least 32 random characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Server-side only. If empty, the app runs but AI chat / symptom analysis return 503.
# Create a key at https://console.groq.com/keys (revoke any key that was ever in frontend code).
GROQ_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Comma-separated list of browser origins allowed to call the API cross-origin
# (only needed when the frontend is hosted on a DIFFERENT origin than this service).
# Example: https://your-frontend.example.com
FRONTEND_ORIGIN=

# auto | true | false — TLS for the database connection. "auto" = TLS only for public hostnames in production.
# DATABASE_SSL=auto

# Serve ../frontend from this service (default true). Set false for an API-only deployment.
# SERVE_FRONTEND=true

# Read-only demo account with synthetic data (default true).
# ENABLE_DEMO=true

# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT_MS=20000
# JWT_EXPIRES_IN=24h
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AI_RATE_LIMIT_MAX=15
# APP_TIMEZONE=Asia/Kolkata
