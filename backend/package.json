{
  "name": "healthcare-backend",
  "version": "2.0.0",
  "description": "API server for the HealthCare app (Express + PostgreSQL + Groq proxy). Also serves the static frontend.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ignore tests server.js",
    "migrate": "node db/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "check": "node scripts/check-syntax.js && node scripts/check-paths.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
